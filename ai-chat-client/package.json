{
  "name": "branch-mind",
  "version": "0.1.2",
  "description": "Branch Mind — mainline learning, independent Q&A branches, styled lectures and portable study memory.",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "prompt-tree": "bin/prompt-tree.mjs",
    "branch-mind": "bin/prompt-tree.mjs"
  },
  "files": [
    "bin/",
    ".next/standalone/"
  ],
  "scripts": {
    "dev": "next dev -p 1666",
    "build": "next build --webpack && node scripts/prepare-standalone.mjs",
    "start": "node bin/prompt-tree.mjs",
    "start:local": "node scripts/start-local.mjs",
    "prepack": "npm run build",
    "test": "vitest",
    "test:run": "vitest run",
    "test:cli": "vitest run src/__tests__/cli/launcher.test.ts",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "privacy:check": "python3 scripts/check-release-privacy.py"
  },
  "dependencies": {
    "date-fns": "^4.1.0",
    "katex": "^0.16.28",
    "next": "16.1.4",
    "pdfjs-dist": "^4.10.38",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-markdown": "^9.0.1",
    "reactflow": "^11.11.4",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "undici": "^7.30.0",
    "uuid": "^13.0.0",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^9",
    "eslint-config-next": "16.1.4",
    "eslint-config-prettier": "^10.1.8",
    "fake-indexeddb": "^6.2.5",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/SuiYueMengHen/BranchMind.git"
  },
  "bugs": {
    "url": "https://github.com/SuiYueMengHen/BranchMind/issues"
  },
  "homepage": "https://github.com/SuiYueMengHen/BranchMind"
}
